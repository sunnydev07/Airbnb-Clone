<%
  const profileInitial = currUser.username ? currUser.username.charAt(0).toUpperCase() : 'U';
  const memberSinceText = profileStats.memberSince
    ? profileStats.memberSince.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })
    : 'New member';
%>

<section class="profile-dashboard">
  <div class="profile-hero-panel">
    <div class="profile-identity">
      <div class="profile-avatar" aria-hidden="true"><%= profileInitial %></div>
      <div>
        <p class="profile-eyebrow">Your account</p>
        <h2><%= currUser.username %></h2>
        <p class="profile-email"><i class="fa-solid fa-envelope"></i> <%= currUser.email %></p>
      </div>
    </div>

    <div class="profile-hero-actions">
      <a href="/listings/createNew" class="profile-primary-action">
        <i class="fa-solid fa-plus"></i>
        Create Listing
      </a>
      <a href="/listings?owner=me" class="profile-secondary-action">
        <i class="fa-solid fa-house-user"></i>
        My Listings
      </a>
    </div>
  </div>

  <div class="profile-stats-grid" aria-label="Profile statistics">
    <article class="profile-stat-card">
      <span class="profile-stat-icon"><i class="fa-solid fa-house"></i></span>
      <div>
        <strong><%= profileStats.listingCount %></strong>
        <span>Active <%= profileStats.listingCount === 1 ? 'listing' : 'listings' %></span>
      </div>
    </article>

    <article class="profile-stat-card">
      <span class="profile-stat-icon"><i class="fa-solid fa-star"></i></span>
      <div>
        <strong><%= profileStats.reviewCount %></strong>
        <span>Total <%= profileStats.reviewCount === 1 ? 'review' : 'reviews' %></span>
      </div>
    </article>

    <article class="profile-stat-card">
      <span class="profile-stat-icon"><i class="fa-solid fa-indian-rupee-sign"></i></span>
      <div>
        <strong><%= profileStats.averagePrice ? profileStats.averagePrice.toLocaleString('en-IN') : '0' %></strong>
        <span>Average nightly price</span>
      </div>
    </article>

    <article class="profile-stat-card">
      <span class="profile-stat-icon"><i class="fa-solid fa-calendar-check"></i></span>
      <div>
        <strong><%= memberSinceText %></strong>
        <span>Member since</span>
      </div>
    </article>
  </div>

  <div class="profile-content-grid">
    <section class="profile-panel">
      <div class="profile-section-heading">
        <div>
          <p class="profile-eyebrow">Hosting snapshot</p>
          <h3>Recent listings</h3>
        </div>
        <% if (ownedListings.length > 3) { %>
          <a href="/listings?owner=me">View all</a>
        <% } %>
      </div>

      <% if (recentListings.length > 0) { %>
        <div class="profile-listing-stack">
          <% for (let listing of recentListings) { %>
            <a href="/listings/<%= listing._id %>" class="profile-listing-row">
              <div class="profile-listing-thumb">
                <% if (listing.image && listing.image.url) { %>
                  <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
                <% } else { %>
                  <i class="fa-solid fa-image"></i>
                <% } %>
              </div>
              <div class="profile-listing-copy">
                <strong><%= listing.title %></strong>
                <span><%= listing.location %>, <%= listing.country %></span>
              </div>
              <div class="profile-listing-price">
                &#8377;<%= listing.price != null ? Number(listing.price).toLocaleString('en-IN') : 'N/A' %>
              </div>
            </a>
          <% } %>
        </div>
      <% } else { %>
        <div class="profile-empty-panel">
          <i class="fa-solid fa-door-open"></i>
          <h4>No listings yet</h4>
          <p>Your hosted stays will appear here once you create your first listing.</p>
          <a href="/listings/createNew" class="profile-primary-action">Start hosting</a>
        </div>
      <% } %>
    </section>

    <aside class="profile-panel profile-account-panel">
      <p class="profile-eyebrow">Account details</p>
      <h3>Ready to host</h3>
      <div class="profile-detail-list">
        <div>
          <span>Username</span>
          <strong><%= currUser.username %></strong>
        </div>
        <div>
          <span>Email</span>
          <strong><%= currUser.email %></strong>
        </div>
        <div>
          <span>Profile status</span>
          <strong>Verified session</strong>
        </div>
      </div>
    </aside>
  </div>
</section>
