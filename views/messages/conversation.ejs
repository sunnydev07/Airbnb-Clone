<% 
    const otherUser = conversation.participants.find(p => !p._id.equals(currUser._id)) || { username: 'Unknown User' };
%>

<div class="container my-4">
    <div class="row">
        <div class="col-md-10 col-lg-8 mx-auto">
            <!-- Back and Conversation Header -->
            <div class="d-flex align-items-center justify-content-between mb-3 p-3 shadcn-card bg-white" style="border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
                <div class="d-flex align-items-center gap-3">
                    <a href="/messages" class="btn btn-sm btn-outline-dark" style="border-radius: 0.5rem; padding: 0.35rem 0.75rem;">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">Chat with @<%= otherUser.username %></h5>
                        <% if (conversation.listing) { %>
                            <div class="text-secondary small">
                                Re: <a href="/listings/<%= conversation.listing._id %>" class="text-decoration-none text-danger fw-semibold"><%= conversation.listing.title %></a>
                            </div>
                        <% } %>
                    </div>
                </div>
                <% if (conversation.listing) { %>
                    <img src="<%= conversation.listing.image.url %>" alt="" class="rounded-2" style="width: 45px; height: 45px; object-fit: cover;">
                <% } %>
            </div>

            <!-- Messages Box -->
            <div class="shadcn-card bg-white mb-3 p-4 d-flex flex-column" style="border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm); height: 500px;">
                <div class="flex-grow-1 overflow-y-auto mb-3 pe-2" id="chat-messages-container" style="overflow-y: auto;">
                    <% if (conversation.messages.length === 0) { %>
                        <div class="h-100 d-flex align-items-center justify-content-center text-muted">
                            No messages in this conversation yet.
                        </div>
                    <% } else { %>
                        <div class="d-flex flex-column gap-3">
                            <% conversation.messages.forEach(msg => { %>
                                <% const isSelf = msg.sender.equals(currUser._id); %>
                                <div class="d-flex flex-column <%= isSelf ? 'align-items-end' : 'align-items-start' %>">
                                    <div class="p-3" style="max-width: 75%; font-size: 0.95rem; line-height: 1.4; border-radius: 18px; 
                                        <%= isSelf ? 'background-color: var(--red); color: #fff; border-bottom-right-radius: 4px;' : 'background-color: #f3f4f6; color: var(--text-primary); border-bottom-left-radius: 4px;' %>">
                                        <%= msg.content %>
                                    </div>
                                    <span class="text-muted font-monospace mt-1" style="font-size: 0.75rem;">
                                        <%= msg.createdAt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- Input Form -->
                <form action="/messages/<%= conversation._id %>" method="POST" class="mt-auto border-top pt-3">
                    <div class="input-group">
                        <input type="text" name="content" class="form-control py-2.5 px-3" placeholder="Type a message..." required autocomplete="off" style="border-radius: 24px 0 0 24px; border-color: var(--border); outline: none;">
                        <button type="submit" class="btn btn-dark px-4" style="border-radius: 0 24px 24px 0;">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const chatContainer = document.getElementById('chat-messages-container');
        if (chatContainer) {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }
    });
</script>
