<div class="listing-show-container mx-auto my-4">
    <div class="listing-show-header mb-3 d-flex justify-content-between align-items-start">
        <div>
            <h1 class="listing-title"><%= listing.title %></h1>
            <div class="text-muted fs-6 d-flex align-items-center gap-2">
                <i class="fa-solid fa-location-dot"></i>
                <span><%= listing.location %>, <%= listing.country %></span>
            </div>
        </div>
        <div>
            <button class="share-btn btn btn-light border" style="border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; padding: 0.4rem 0.8rem; background: #fff;">
                <i class="fa-solid fa-arrow-up-from-bracket"></i> Share
            </button>
        </div>
    </div>

    <div class="listing-hero mb-4">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="listing-hero-img" />
    </div>

    <div class="row g-5">
        <div class="col-lg-8">
            <div class="host-badge mb-4">
                <div class="host-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <div class="host-name">Hosted by <%= listing.owner && listing.owner.username ? listing.owner.username : 'Unknown host' %></div>
                    <div class="text-muted small">Superhost &middot; 4 years hosting</div>
                </div>
            </div>
            
            <hr class="my-4">

            <div class="listing-desc mb-4">
                <h4 class="section-title">About this space</h4>
                <p class="text-secondary mt-3" style="line-height:1.75;"><%= listing.description %></p>
            </div>

            <hr class="my-4">

            <div class="map-section mb-4">
                <h4 class="section-title">Where you'll be</h4>
                <p class="text-muted mb-3"><i class="fa-solid fa-location-arrow"></i> <%= listing.location %>, <%= listing.country %></p>
                <div class="map-container shadcn-card p-0">
                    <div id="map"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="shadcn-card sticky-pricing-card">
                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span class="price-display">&#8377;<%= listing.price != null ? listing.price.toLocaleString('en-IN') : 'N/A' %></span>
                    <span class="text-muted">/ night</span>
                </div>

                <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
                    <div class="d-flex flex-column gap-3">
                        <form action="/listings/<%= listing._id %>/edit" method="GET" class="w-100">
                            <button class="btn-reserve w-100" style="background:#222;">Edit Listing</button>
                        </form>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="w-100">
                            <button class="btn-outline-shadcn w-100" style="border-color:var(--red); color:var(--red);">Delete Listing</button>
                        </form>
                    </div>
                <% } else { %>
                    <form action="/listings/<%= listing._id %>/book" method="POST" id="booking-form" class="needs-validation" novalidate>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="checkIn" class="form-label small fw-semibold text-secondary">Check-in</label>
                                <input type="date" id="checkIn" name="booking[checkIn]" class="form-control form-control-sm" required min="<%= new Date().toISOString().split('T')[0] %>">
                            </div>
                            <div class="col-6">
                                <label for="checkOut" class="form-label small fw-semibold text-secondary">Check-out</label>
                                <input type="date" id="checkOut" name="booking[checkOut]" class="form-control form-control-sm" required min="<%= new Date().toISOString().split('T')[0] %>">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="guests" class="form-label small fw-semibold text-secondary">Guests</label>
                            <select id="guests" name="booking[guests]" class="form-select form-select-sm" required>
                                <option value="1" selected>1 guest</option>
                                <option value="2">2 guests</option>
                                <option value="3">3 guests</option>
                                <option value="4">4 guests</option>
                                <option value="5">5 guests</option>
                                <option value="6">6 guests</option>
                            </select>
                        </div>
                        
                        <!-- Price Breakdown -->
                        <div id="price-breakdown" class="d-none border-top pt-3 mt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary" id="nightly-calc">&#8377;<%= listing.price %> x 0 nights</span>
                                <span class="text-dark fw-semibold" id="base-price">&#8377;0</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary">Airbnb service fee (14%)</span>
                                <span class="text-dark fw-semibold" id="service-fee">&#8377;0</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-3">
                                <strong class="text-dark">Total before taxes</strong>
                                <strong class="text-dark" id="total-price">&#8377;0</strong>
                            </div>
                        </div>

                        <button type="submit" class="btn-reserve w-100 py-2.5 mb-2">Reserve</button>
                        <div class="text-center text-muted small mt-2">You won't be charged yet</div>
                    </form>
                    
                    <!-- Contact Host Button for Non-Owners -->
                    <% if (currUser && listing.owner && !currUser._id.equals(listing.owner._id)) { %>
                        <form action="/listings/<%= listing._id %>/contact" method="POST" class="mt-3">
                            <button class="btn btn-outline-dark w-100" style="border-radius:0.5rem; font-weight:600;">
                                <i class="fa-regular fa-comment-dots me-2"></i>Contact Host
                            </button>
                        </form>
                    <% } else if (!currUser) { %>
                        <a href="/login" class="btn btn-outline-dark w-100 mt-3 d-block text-center text-decoration-none" style="border-radius:0.5rem; font-weight:600; padding:0.5rem;">
                            <i class="fa-regular fa-comment-dots me-2"></i>Contact Host
                        </a>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>
    
    <hr class="my-5">

    <div class="reviews-section mb-5">
        <h4 class="section-title mb-4">
            <i class="fa-solid fa-star text-warning"></i> 
            <%= listing.reviews.length > 0 ? listing.reviews.length + ' Reviews' : 'No reviews yet' %>
        </h4>

        <% if(currUser) { %>
            <div class="shadcn-card mb-5">
                <h5 class="mb-3" style="font-weight:600;">Leave a Review</h5>
                <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                    <div class="mb-3">
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label text-muted">How was your experience?</label>
                        <textarea name="review[comment]" id="comment" class="form-control" rows="4" required style="border-radius:0.5rem;"></textarea>
                        <div class="invalid-feedback">Please write a little bit about your experience.</div>
                    </div>
                    <button class="btn btn-dark" style="border-radius:0.5rem; padding:0.5rem 1.5rem;">Submit Review</button>
                </form>
            </div>
        <% } else { %>
            <div class="alert alert-secondary">
                You must be <a href="/login">logged in</a> to leave a review.
            </div>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
            <div class="row g-4">
                <% for (review of listing.reviews) { %>
                    <div class="col-md-6">
                        <div class="shadcn-card review-card" id="review-card-<%= review._id %>">
                            <!-- View Mode -->
                            <div class="review-view-mode">
                                <div class="review-header">
                                    <div class="review-avatar">
                                        <%= review.author.username.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@<%= review.author.username %></h6>
                                        <div class="text-muted small">
                                            <p class="starability-result" data-rating="<%= review.rating %>" style="transform: scale(0.6); transform-origin: left; margin:0;">
                                                Rated: <%= review.rating %> stars
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-secondary mt-2 mb-3 review-comment-text" style="font-size:0.95rem;"><%= review.comment %></p>
                                <div class="d-flex gap-2">
                                    <% if (currUser && review.author._id.equals(currUser._id)) { %>
                                        <button class="btn btn-sm btn-outline-dark edit-review-btn" data-review-id="<%= review._id %>" style="border-radius: 0.5rem;">Edit</button>
                                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline">
                                            <button class="btn btn-sm btn-outline-danger" style="border-radius: 0.5rem;">Delete</button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                            
                            <!-- Edit Mode Form (hidden by default) -->
                            <% if (currUser && review.author._id.equals(currUser._id)) { %>
                                <div class="review-edit-mode d-none mt-2">
                                    <h6 class="fw-bold mb-2">Edit your review</h6>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PUT" class="needs-validation" novalidate>
                                        <div class="mb-2">
                                            <fieldset class="starability-slot">
                                                <input type="radio" id="edit-no-rate-<%= review._id %>" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                                                <input type="radio" id="edit-rate1-<%= review._id %>" name="review[rating]" value="1" <%= review.rating === 1 ? 'checked' : '' %> />
                                                <label for="edit-rate1-<%= review._id %>" title="Terrible">1 star</label>
                                                <input type="radio" id="edit-rate2-<%= review._id %>" name="review[rating]" value="2" <%= review.rating === 2 ? 'checked' : '' %> />
                                                <label for="edit-rate2-<%= review._id %>" title="Not good">2 stars</label>
                                                <input type="radio" id="edit-rate3-<%= review._id %>" name="review[rating]" value="3" <%= review.rating === 3 ? 'checked' : '' %> />
                                                <label for="edit-rate3-<%= review._id %>" title="Average">3 stars</label>
                                                <input type="radio" id="edit-rate4-<%= review._id %>" name="review[rating]" value="4" <%= review.rating === 4 ? 'checked' : '' %> />
                                                <label for="edit-rate4-<%= review._id %>" title="Very good">4 stars</label>
                                                <input type="radio" id="edit-rate5-<%= review._id %>" name="review[rating]" value="5" <%= review.rating === 5 ? 'checked' : '' %> />
                                                <label for="edit-rate5-<%= review._id %>" title="Amazing">5 stars</label>
                                            </fieldset>
                                        </div>
                                        <div class="mb-2">
                                            <textarea name="review[comment]" class="form-control" rows="3" required style="border-radius:0.5rem;"><%= review.comment %></textarea>
                                            <div class="invalid-feedback">Please enter a comment.</div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-sm btn-dark px-3" style="border-radius:0.5rem;">Save</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary cancel-edit-btn" data-review-id="<%= review._id %>" style="border-radius:0.5rem;">Cancel</button>
                                        </div>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<script>
    // Share functionality
    document.addEventListener('DOMContentLoaded', () => {
        const shareBtn = document.querySelector('.share-btn');
        if (shareBtn) {
            shareBtn.addEventListener('click', async () => {
                const shareData = {
                    title: "<%= listing.title %>",
                    text: "Check out this stay on Airbnb Clone!",
                    url: window.location.href
                };

                if (navigator.share) {
                    try {
                        await navigator.share(shareData);
                    } catch (err) {
                        console.error('Share failed:', err);
                    }
                } else {
                    try {
                        await navigator.clipboard.writeText(window.location.href);
                        showToast('Link copied to clipboard!');
                    } catch (err) {
                        console.error('Clipboard copy failed:', err);
                    }
                }
            });
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'share-toast';
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => toast.classList.add('show'), 10);
            
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 2000);
        }

        // Booking system price calculations
        const checkInInput = document.getElementById('checkIn');
        const checkOutInput = document.getElementById('checkOut');
        const priceBreakdown = document.getElementById('price-breakdown');
        const nightlyCalc = document.getElementById('nightly-calc');
        const basePriceEl = document.getElementById('base-price');
        const serviceFeeEl = document.getElementById('service-fee');
        const totalPriceEl = document.getElementById('total-price');

        const nightlyPrice = <%= listing.price || 0 %>;

        function updatePrice() {
            if (!checkInInput || !checkOutInput) return;
            const checkInVal = checkInInput.value;
            const checkOutVal = checkOutInput.value;

            if (checkInVal && checkOutVal) {
                const checkInDate = new Date(checkInVal);
                const checkOutDate = new Date(checkOutVal);

                if (checkOutDate > checkInDate) {
                    const diffTime = Math.abs(checkOutDate - checkInDate);
                    const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    
                    const basePrice = nightlyPrice * nights;
                    const serviceFee = Math.round(basePrice * 0.14);
                    const totalPrice = basePrice + serviceFee;

                    if (nightlyCalc) nightlyCalc.textContent = `\u20B9${nightlyPrice.toLocaleString('en-IN')} x ${nights} night${nights > 1 ? 's' : ''}`;
                    if (basePriceEl) basePriceEl.textContent = `\u20B9${basePrice.toLocaleString('en-IN')}`;
                    if (serviceFeeEl) serviceFeeEl.textContent = `\u20B9${serviceFee.toLocaleString('en-IN')}`;
                    if (totalPriceEl) totalPriceEl.textContent = `\u20B9${totalPrice.toLocaleString('en-IN')}`;

                    if (priceBreakdown) priceBreakdown.classList.remove('d-none');
                } else {
                    if (priceBreakdown) priceBreakdown.classList.add('d-none');
                }
            } else {
                if (priceBreakdown) priceBreakdown.classList.add('d-none');
            }
        }

        if (checkInInput && checkOutInput) {
            checkInInput.addEventListener('change', (e) => {
                checkOutInput.min = e.target.value;
                updatePrice();
            });
            checkOutInput.addEventListener('change', updatePrice);
        }

        // Review inline editing
        document.querySelectorAll('.edit-review-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const reviewId = btn.getAttribute('data-review-id');
                const card = document.getElementById(`review-card-${reviewId}`);
                card.querySelector('.review-view-mode').classList.add('d-none');
                card.querySelector('.review-edit-mode').classList.remove('d-none');
            });
        });

        document.querySelectorAll('.cancel-edit-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const reviewId = btn.getAttribute('data-review-id');
                const card = document.getElementById(`review-card-${reviewId}`);
                card.querySelector('.review-edit-mode').classList.add('d-none');
                card.querySelector('.review-view-mode').classList.remove('d-none');
            });
        });
    });

    // Map initialization
    function initMap() {
        const address = <%- JSON.stringify(`${listing.location}, ${listing.country}`) %>;
        const listingTitle = <%- JSON.stringify(listing.title) %>;
        const listingLocation = <%- JSON.stringify(listing.location) %>;

        const storedLat = <%- JSON.stringify(mapCoordinates && mapCoordinates.latitude != null ? mapCoordinates.latitude : null) %>;
        const storedLng = <%- JSON.stringify(mapCoordinates && mapCoordinates.longitude != null ? mapCoordinates.longitude : null) %>;
        const hasStoredCoords = typeof storedLat === 'number'
            && typeof storedLng === 'number'
            && Number.isFinite(storedLat)
            && Number.isFinite(storedLng);

        const tempCenter = hasStoredCoords ? { lat: storedLat, lng: storedLng } : { lat: 20, lng: 0 };

        const map = new google.maps.Map(document.getElementById('map'), {
            zoom: 14,
            center: tempCenter,
            mapTypeId: 'roadmap',
            disableDefaultUI: true,
            zoomControl: true,
            fullscreenControl: true,
            styles: [
                { featureType: 'poi', stylers: [{ visibility: 'off' }] },
                { featureType: 'transit', stylers: [{ visibility: 'off' }] }
            ]
        });

        const infoWindow = new google.maps.InfoWindow({
            content: `
                <div style="padding: 10px 5px 5px; font-family: 'Plus Jakarta Sans', sans-serif;">
                    <h6 style="font-weight:700; margin-bottom: 4px; font-size:1rem;">${listingTitle}</h6>
                    <p style="margin-bottom: 0; color:#555; font-size:0.85rem;"><i class="fa-solid fa-location-dot"></i> ${listingLocation}</p>
                </div>
            `,
            maxWidth: 250
        });

        const placeMarker = (position) => {
            const marker = new google.maps.Marker({
                position,
                map,
                title: listingTitle,
                icon: 'http://maps.google.com/mapfiles/ms/icons/red-dot.png',
                animation: google.maps.Animation.DROP
            });
            marker.addListener('click', () => {
                infoWindow.open(map, marker);
            });
        };

        const geocoder = new google.maps.Geocoder();
        geocoder.geocode({ address: address }, (results, status) => {
            if (status === 'OK' && results[0]) {
                const location = results[0].geometry.location;
                map.setCenter(location);
                map.setZoom(14);
                placeMarker(location);
            } else if (hasStoredCoords) {
                map.setCenter(tempCenter);
                placeMarker(tempCenter);
            } else {
                console.warn('Could not geocode address:', address, 'Status:', status);
                document.getElementById('map').innerHTML =
                    '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#888;font-size:1rem;">Map location unavailable for this listing</div>';
            }
        });
    }
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.GOOGLE_MAP_API_KEY %>&callback=initMap" async defer></script>
