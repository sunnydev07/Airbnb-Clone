<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold" style="letter-spacing: -0.5px;">Hosting Dashboard</h1>
            <p class="text-secondary mb-0">Manage reservations for the listings you host</p>
        </div>
        <a href="/profile" class="btn btn-outline-dark" style="border-radius: 0.5rem; font-weight: 600;">
            <i class="fa-solid fa-chart-line me-2"></i>Performance Stats
        </a>
    </div>

    <% if (bookings.length === 0) { %>
        <div class="text-center py-5 shadcn-card my-5" style="border-radius: var(--radius); border: 1px solid var(--border);">
            <div class="mb-3">
                <i class="fa-solid fa-house-laptop text-muted" style="font-size: 3.5rem;"></i>
            </div>
            <h3 class="fw-bold">No bookings yet</h3>
            <p class="text-secondary max-w-md mx-auto mb-4" style="max-width: 400px;">
                Once guests reserve your listings, they will show up here. Make sure your listing details are up to date!
            </p>
            <a href="/listings?owner=me" class="btn btn-dark px-4 py-2" style="border-radius: 0.5rem; font-weight: 600;">
                Manage Listings
            </a>
        </div>
    <% } else { %>
        <div class="shadcn-card p-4" style="border-radius: var(--radius); border: 1px solid var(--border); background: #fff; box-shadow: var(--shadow-sm);">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <tr>
                            <th scope="col">Listing</th>
                            <th scope="col">Guest</th>
                            <th scope="col">Check-in</th>
                            <th scope="col">Check-out</th>
                            <th scope="col" class="text-center">Guests</th>
                            <th scope="col">Payout</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(booking => { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;">
                                        <div>
                                            <a href="/listings/<%= booking.listing._id %>" class="fw-bold text-dark text-decoration-none hover-opacity">
                                                <%= booking.listing.title %>
                                            </a>
                                            <div class="text-muted small"><%= booking.listing.location %>, <%= booking.listing.country %></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@<%= booking.guest.username %></div>
                                    <div class="text-muted small"><%= booking.guest.email %></div>
                                </td>
                                <td class="text-secondary font-monospace" style="font-size: 0.9rem;">
                                    <%= booking.checkIn.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                </td>
                                <td class="text-secondary font-monospace" style="font-size: 0.9rem;">
                                    <%= booking.checkOut.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                </td>
                                <td class="text-center fw-semibold text-dark">
                                    <%= booking.guests %>
                                </td>
                                <td class="fw-bold text-dark">
                                    &#8377;<%= booking.totalPrice.toLocaleString('en-IN') %>
                                </td>
                                <td>
                                    <span class="badge px-3 py-2" style="border-radius: 20px; font-weight: 600; font-size: 0.75rem; color: white; background-color: <%= booking.status === 'confirmed' ? '#22c55e' : (booking.status === 'cancelled' ? '#ef4444' : '#f59e0b') %>;">
                                        <%= booking.status.toUpperCase() %>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <% if (booking.status !== 'cancelled' && new Date(booking.checkIn) > new Date()) { %>
                                        <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking? This will notify the guest.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 0.4rem; font-weight: 600; font-size: 0.8rem;">
                                                Cancel
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-muted small">-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>
